<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== "undefined" ? title : "Reservas de salas de estudio" %></title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <header>
        <h1>Reservas de salas de estudio</h1>

        <nav aria-label="Navegación principal">
            <a href="/">Inicio</a>
            <a href="/reservas">Reservas</a>
            <a href="/reservas/nueva">Nueva reserva</a>
            <a href="/estado">Estado</a>
        </nav>
    </header>

    <main>
        <%- body %>
    </main>

    <footer>
        <p>
            <%= typeof seccion !== "undefined" ? seccion : "Biblioteca" %>
        </p>

        <p>
            Solicitud: <%= solicitudId %>
        </p>
    </footer>
</body>
</html>